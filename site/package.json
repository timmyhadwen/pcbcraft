{
  "name": "pcbcraft-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/externalize-inline.mjs",
    "preview": "astro preview",
    "test:contrast": "node --test scripts/check-contrast.mjs",
    "test:a11y": "node scripts/check-a11y.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test": "npm run test:contrast && npm run test:features && npm run check && npm run build && npm run test:links && npm run test:csp",
    "test:features": "node --test scripts/check-features.mjs",
    "test:csp": "node scripts/check-csp.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "yaml": "2.9.1",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3",
    "axe-core": "4.13.0"
  }
}
