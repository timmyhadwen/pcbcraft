---
// Footer shared by the marketing layout and the Starlight Footer override.
// Rules: the legal line is the owner's decision (2026-10-29): docs and screenshots CC BY-SA
// 4.0, code GPL-3.0, name and logo reserved. It appears on every page, marketing and docs.
// Do not: reword the line or drop a link; the full text is in site/LICENSE-docs and /license/.
import Brand from './Brand.astro';
import { footerColumns, url } from '../lib/site';

const columns = footerColumns();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="about">
      <Brand />
      <p>Schematic, board layout, libraries and checks in one window. Free software under the GPL.</p>
    </div>
    {
      columns.map((col) => (
        <nav aria-label={col.title}>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                  {l.label}
                  {l.external && <span class="ext" aria-hidden="true"> ↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap legal">
    <p class="license">
      Docs and screenshots <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener">CC BY-SA 4.0</a>.{" "}
      Code <a href="https://www.gnu.org/licenses/gpl-3.0.html" rel="noopener">GPL-3.0</a>.{" "}
      <a href={url('license/')}>PCBCraft name and logo reserved</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 3rem 0 2rem;
    color: var(--pc-muted);
    background: var(--pc-bg);
    border-top: 1px solid var(--pc-line);
    font-size: 0.92rem;
  }
  .wrap {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 2rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .about p {
    max-width: 22rem;
    margin: 1rem 0 0;
  }
  h2 {
    margin: 0 0 0.9rem;
    font: 600 0.75rem/1 var(--pc-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc-copper);
    border: 0;
  }
  h2::before {
    display: none;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    margin: 0.2rem 0;
  }
  a {
    display: inline-block;
    padding: 0.2rem 0;
    color: var(--pc-text);
    text-decoration: none;
  }
  a:hover {
    color: var(--pc-copper);
    text-decoration: underline;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--pc-line);
    font-size: 0.85rem;
  }
  .license {
    margin: 0;
  }
  .legal a {
    color: var(--pc-cyan);
    text-decoration: underline;
  }
  @media (max-width: 52rem) {
    .wrap {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
