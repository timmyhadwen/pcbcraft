---
// Light and dark toggle used in the header on every page (also replaces Starlight's select).
// Context: writes the same `starlight-theme` key Starlight's ThemeProvider reads, so the
// choice carries between the marketing pages and the docs.
// Rules: the button names the action, not the state ("Switch to light theme").
// Do not: add a third "auto" state here; no stored value means "follow the system".
---

<button type="button" class="theme-toggle" data-theme-toggle title="Switch theme" aria-label="Switch theme">
  <svg class="icon sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
  </svg>
</button>

<script>
  const KEY = 'starlight-theme';
  const root = document.documentElement;
  function sync() {
    const dark = root.dataset.theme !== 'light';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
      b.setAttribute('aria-label', label);
      b.title = label;
    });
  }
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest('[data-theme-toggle]');
    if (!btn) return;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
    sync();
  });
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    color: var(--pc-text);
    background: var(--pc-surface);
    border: 1px solid var(--pc-edge);
    border-radius: 6px;
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: var(--pc-copper);
    color: var(--pc-copper);
  }
  :global(:root[data-theme='light']) .moon,
  :global(:root:not([data-theme='light'])) .sun {
    display: none;
  }
</style>
