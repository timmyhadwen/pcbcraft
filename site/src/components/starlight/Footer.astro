---
// Starlight Footer override: Starlight's edit link and previous/next, then the shared footer.
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import SiteFooter from '../SiteFooter.astro';
---

<div class="docs-footer">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
</div>
<SiteFooter />

<style>
  .docs-footer {
    margin-top: 3rem;
  }
  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--pc-muted);
  }
</style>
