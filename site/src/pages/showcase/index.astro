---
// Showcase: boards made with PCBCraft. No entries exist yet, so it shows marked slots.
// Real entries come from src/content/showcase (a later issue); until then nothing is invented.
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import ShotFrame from '../../components/ShotFrame.astro';
import { home } from '../../lib/copy';
---

<MarketingLayout title="Showcase" description="Boards made with PCBCraft.">
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">Showcase</p>
      <h1>{home.showcase.title.text}</h1>
      <p class="lede" data-slot="COPY #718">Placeholder line about boards built by users and how to submit one. Final copy lands with #718.</p>
    </div>
  </section>
  <section class="wrap grid" aria-label="Showcase entries">
    {
      Array.from({ length: 6 }, (_, i) => (
        <div class="entry">
          <ShotFrame id={`showcase-${i + 1}`} alt={`Placeholder for showcase board photo ${i + 1}`} title="Showcase" ratio="4 / 3" />
          <p class="meta mono">Board name · author · project link</p>
        </div>
      ))
    }
  </section>
</MarketingLayout>

<style>
  .head {
    padding: 3.5rem 0 2rem;
  }
  .grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .meta {
    margin: 0.6rem 0 0;
    color: var(--pc-muted);
    font-size: 0.78rem;
  }
</style>
